# BOTLAB Auditor - example environment file.
# Copy it to ".env" on the server and fill in the one secret. NEVER commit the real .env.
#
#   cp .env.example .env
#   nano .env
#
# ---------------------------------------------------------------- Vultr Serverless Inference
# Create the key in the Vultr customer portal: Products -> Serverless Inference -> your instance
# -> API Keys. Paste it after the "=" with no quotes and no spaces.
# Leaving it empty is supported: the agent then uses its deterministic offline planner, runs the
# same tools in the same order, and the whole demo still works.
LLM_API_KEY=

# Vultr Serverless Inference is OpenAI-compatible, so only the base URL and the model change.
LLM_BASE_URL=https://api.vultrinference.com/v1
LLM_MODEL=llama-3.3-70b-instruct

# ------------------------------------------------------------------------------------ sandbox
# "docker" is the production backend. "local" is the development fallback and is NOT a security
# boundary - never use it on a public server.
SANDBOX_BACKEND=docker
SANDBOX_IMAGE=botlab-sandbox:latest

# Per-run limits for the sandbox container.
SANDBOX_TIMEOUT=20
SANDBOX_MEM_MB=512
SANDBOX_CPUS=1.0
SANDBOX_MAX_BARS=20000

# ----------------------------------------------------------------------------------- web app
PORT=8780
